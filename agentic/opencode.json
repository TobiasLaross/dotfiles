{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-opus-5.0",
  "lsp": true,
  "mcp": {
    "figma": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": true
    }
  },
  "instructions": ["~/.claude/CLAUDE.md", "~/.claude/*.local.md"],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "bash": "allow",
    "external_directory": {
      "~/.claude/**": "allow",
      "~/.claude/repo-context/*": "allow",
      "~/Developer/work/**": "allow",
      "~/Developer/personal/**": "allow",
      "~/dotfiles/**": "allow",
      "/tmp/**": "allow"
    }
  }
}
